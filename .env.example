# Copy to .env and change the values:   cp .env.example .env
# .env is git-ignored. In production these come from a secret manager, never from the repo.

RABBITMQ_USER=maltashop
RABBITMQ_PASSWORD=change-me-broker

ORDER_DB_PASSWORD=change-me-orders
INVENTORY_DB_PASSWORD=change-me-inventory
NOTIFICATION_DB_PASSWORD=change-me-notifications

# Image tag. CI sets this to the git commit SHA ("build once, promote everywhere").
APP_VERSION=dev

# Fault injection for the March-incident demo (0 = off). e.g. 20000 leaks ~20 MB per order.
SIMULATED_LEAK_KB_PER_MESSAGE=0
